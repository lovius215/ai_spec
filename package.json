{
  "name": "@loviusc/sa-spec",
  "version": "0.2.11",
  "description": "Personal system analysis documentation workspace CLI",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lovius215/ai_spec.git"
  },
  "homepage": "https://github.com/lovius215/ai_spec#readme",
  "bugs": {
    "url": "https://github.com/lovius215/ai_spec/issues"
  },
  "bin": {
    "sa-spec": "bin/sa-spec.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "install.sh",
    "update.sh",
    "uninstall.sh",
    "install.bat",
    "update.bat",
    "uninstall.bat",
    "readme.md",
    "README*.md",
    "CHANGELOG.md",
    "examples/"
  ],
  "scripts": {
    "check": "node --check src/cli.js && node --check src/pdf.js && node --check src/i18n.js && node --check src/git.js && node --check src/validator.js && node --check src/instructions.js && node --check bin/sa-spec.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "system-analysis",
    "requirements",
    "srs",
    "documentation",
    "i18n"
  ],
  "license": "MIT"
}
